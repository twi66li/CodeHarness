+    """Expand direct roles into the full transitive set of effective roles.
+
+    Inheritance is followed through ``hierarchy`` until no new role is
+    discovered.  ``visited`` guards against cyclic hierarchies
+    (e.g. ``{"a": ("b",), "b": ("a",)}``) so expansion always terminates.
+    """
+    result = set()
+    pending = list(direct_roles or ())
+    visited = set()
+    while pending:
+        role = pending.pop()
+        if role in visited:
+            continue
+        visited.add(role)
+        result.add(role)
+        pending.extend(hierarchy.get(role, ()) or ())
+    return result
