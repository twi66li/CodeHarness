@@ -1,5 +1,22 @@
 def expand_roles(direct_roles, hierarchy):
-    result = set(direct_roles)
-    for role in list(direct_roles):
-        result.update(hierarchy.get(role, ()))
-    return result
+    """Expand ``direct_roles`` into the full set of effective roles.
+
+    Inheritance is applied transitively (a -> b -> c yields {a, b, c}) using an
+    iterative work-list, so arbitrarily deep hierarchies are handled without
+    recursion limits.  Every role is visited at most once, which makes cyclic
+    inheritance (a -> b -> a) terminate instead of looping forever.
+    """
+    hierarchy = hierarchy or {}
+    result = set()
+    visited = set()
+    pending = list(direct_roles or ())
+    while pending:
+        role = pending.pop()
+        if role in visited:
+            continue
+        visited.add(role)
+        result.add(role)
+        for parent in hierarchy.get(role, ()) or ():
+            if parent not in visited:
+                pending.append(parent)
+    return result
--- app/policies.py
+++ app/policies.py
@@ -1,6 +1,18 @@
 def evaluate(roles, rules, resource, action):
-    decision = False
-    for rule in rules:
-        if rule.role in roles and rule.resource in {resource, "*"} and rule.action in {action, "*"}:
-            decision = rule.effect == "allow"
-    return decision
+    """Evaluate ``rules`` for ``roles`` against ``resource`` / ``action``.
+
+    An explicit ``deny`` rule always wins: as soon as one matching deny rule is
+    found the request is refused, regardless of how many matching allow rules
+    exist and regardless of rule ordering.  Without any matching rule the
+    default decision is deny (fail closed).
+    """
+    roles = set(roles or ())
+    allowed = False
+    for rule in rules or ():
+        if rule.role not in roles:
+            continue
+        if rule.resource not in {resource, "*"}:
+            continue
+        if rule.action not in {action, "*"}:
+            continue
+        if rule.effect == "deny":
+            return False
+        if rule.effect == "allow":
+            allowed = True
+    return allowed
