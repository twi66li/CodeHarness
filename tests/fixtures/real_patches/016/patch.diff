@@ -1,3 +1,10 @@
 def page(items, number, size):
-    start = number * size
-    return items[start:start + size]
+    """Return one page of ``items``.
+
+    Page numbers are 1-based. Pages outside the available range yield an
+    empty list.
+    """
+    if number < 1 or size < 1:
+        return []
+    start = (number - 1) * size
+    if start >= len(items):
+        return []
+    return list(items[start:start + size])
