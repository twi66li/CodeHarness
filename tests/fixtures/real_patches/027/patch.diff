+    default is deny.
+    """
+    roles = set(roles or ())
+    allowed = False
+    for rule in rules or ():
+        if rule.role not in roles:
+            continue
+        if rule.resource not in {resource, "*"}:
+            continue
+        if rule.action not in {action, "*"}:
+            continue
+        effect = (rule.effect or "").strip().lower()
+        if effect == "deny":
+            return False
+        if effect == "allow":
+            allowed = True
+    return allowed
