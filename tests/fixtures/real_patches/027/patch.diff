-    result = set(direct_roles)
-    for role in list(direct_roles):
-        result.update(hierarchy.get(role, ()))
+    """Transitively expand direct roles through the inheritance hierarchy.
+
+    Every role is visited at most once, so multi-level inheritance is fully
+    expanded and cyclic hierarchies (a -> b -> a) terminate instead of
+    looping forever.
+    """
+    hierarchy = hierarchy or {}
+    result = set()
+    pending = list(direct_roles or ())
+    while pending:
+        role = pending.pop()
+        if role in result:
+            continue
+        result.add(role)
+        inherited = hierarchy.get(role)
+        if not inherited:
+            continue
+        if isinstance(inherited, str):
+            inherited = (inherited,)
+        for parent in inherited:
+            if parent not in result:
+                pending.append(parent)
     return result
