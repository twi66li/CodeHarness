@@ -1,3 +1,5 @@
 def calculate_tax(subtotal, discount, rate_bps):
-    taxable = subtotal
+    # 计税基数 = 扣除优惠券后的金额
+    taxable = subtotal - discount
+    if taxable < 0:
+        taxable = 0
     return (taxable * rate_bps + 5000) // 10000
--- app/inventory.py
