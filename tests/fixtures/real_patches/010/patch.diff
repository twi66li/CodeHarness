--- app/coupons.py
+++ app/coupons.py
@@ -1,6 +1,12 @@
 def discount_cents(subtotal, coupon):
     if coupon is None:
         return 0
-    if subtotal > coupon.threshold:
-        return coupon.amount
-    return 0
+    if coupon.amount <= 0:
+        return 0
+    # 达到阈值（含等于）即可使用
+    if subtotal < coupon.threshold:
+        return 0
+    # 折后金额不得低于 0：优惠金额不超过小计
+    return min(coupon.amount, max(0, subtotal))
--- app/tax.py
