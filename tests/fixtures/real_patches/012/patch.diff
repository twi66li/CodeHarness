--- app/validators.py
+++ app/validators.py
@@ -1,7 +1,24 @@
+"""凭证校验：金额必须为正，且借贷必须平衡。"""
+
+VALID_SIDES = ("debit", "credit")
+
+
 def validate_voucher(entries):
     if not entries:
         raise ValueError("empty voucher")
-    debit = sum(e.amount for e in entries if e.side == "debit")
-    credit = sum(e.amount for e in entries if e.side == "credit")
+    debit = 0
+    credit = 0
+    for entry in entries:
+        if entry.side not in VALID_SIDES:
+            raise ValueError(f"invalid entry side: {entry.side!r}")
+        amount = entry.amount
+        if isinstance(amount, bool) or not isinstance(amount, (int, float)):
+            raise ValueError(f"entry amount must be numeric: {amount!r}")
+        if amount <= 0:
+            raise ValueError(f"entry amount must be positive: {amount!r}")
+        if entry.side == "debit":
+            debit += amount
+        else:
+            credit += amount
     if debit != credit:
         raise ValueError("unbalanced voucher")
